{
  "name": "kasette",
  "version": "1.3.0",
  "private": false,
  "description": "A 100% offline, client-side music player PWA. Import local audio files, play in the background, no accounts, no servers.",
  "license": "BSD-3-Clause",
  "scripts": {
    "dev": "npx --yes serve www",
    "cap:sync": "npx cap sync android",
    "cap:android": "npx cap open android",
    "assets:generate": "npx capacitor-assets generate",
    "lint": "eslint www/*.js",
    "deploy:cloudflare": "wrangler pages deploy www --project-name=kasette"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/status-bar": "^7.0.6"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.0",
    "@capacitor/cli": "^7.0.0",
    "eslint": "^9.0.0",
    "wrangler": "^4.0.0"
  }
}
